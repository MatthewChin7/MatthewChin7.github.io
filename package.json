{
  "name": "signal-archive",
  "version": "0.1.0",
  "private": true,
  "description": "The Signal Archive — Matthew Chin's personal research atlas",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "tsx scripts/validate-content.ts",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:content": "tsx scripts/validate-content.ts",
    "new:note": "tsx scripts/new-content.ts note",
    "new:project": "tsx scripts/new-content.ts project",
    "new:musing": "tsx scripts/new-content.ts musing"
  },
  "//katex": "Pinned to the 0.16 line on purpose: rehype-katex@7 renders the article HTML with its own katex ^0.16, and the CSS imported by the pages must come from the same version. Across the 0.16/0.18 boundary KaTeX renamed internal classes (inner -> katex-inner), which silently breaks constructs the stylesheet positions by hand, e.g. the overlay that turns = into != .",
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.19",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.47",
    "motion": "^12.42.2",
    "next": "^16.2.10",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.4",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.10",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.15.0"
}
